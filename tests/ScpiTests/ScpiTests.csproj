<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SCPI transport + waveform checks:
        dotnet run project tests/ScpiTests              (fake instrument only)
        dotnet run project tests/ScpiTests 169.254.1.2  (also hits a real one)
    Exit code 0 means every check passed. Compiles the SCPI sources directly so it
    runs without the Avalonia/Voxon dependency chain.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScpiTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ScpiSrc>$(MSBuildThisFileDirectory)..\..\Core\Sim\Scpi</ScpiSrc>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="RealScope.cs" />
    <Compile Include="$(ScpiSrc)\ScpiTransport.cs" />
    <Compile Include="$(ScpiSrc)\ScpiScope.cs" />
  </ItemGroup>

</Project>
