<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Parser checks for the PCB importers, as a plain console exe:
        dotnet run project tests/PcbParserTests
    Exit code 0 means every check passed. It compiles the parser sources
    directly (no project reference) so it stays runnable without the
    Avalonia/Voxon dependency chain, and so it can never drift from the
    files that actually ship.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PcbParserTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PcbSrc>$(MSBuildThisFileDirectory)..\..\Core\Pcb</PcbSrc>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Palette only needs System, so pulling it in keeps ONE definition of the
         display's seven colours instead of duplicating hex literals here, without
         dragging in the Avalonia/Voxon chain this harness exists to avoid. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\Palette.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\Layout.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\Ohm.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\Ohm.Presets.cs" />
    <Compile Include="$(PcbSrc)\PcbBoard.cs" />
    <Compile Include="$(PcbSrc)\GerberParser.cs" />
    <Compile Include="$(PcbSrc)\ExcellonParser.cs" />
    <Compile Include="$(PcbSrc)\PlacementParser.cs" />
    <Compile Include="$(PcbSrc)\MeshLoader.cs" />
    <Compile Include="$(PcbSrc)\PcbImporter.cs" />
    <Compile Include="$(PcbSrc)\XlsxReader.cs" />
    <Compile Include="$(PcbSrc)\CadModel.cs" />
    <Compile Include="$(PcbSrc)\StepParser.cs" />
    <Compile Include="$(PcbSrc)\PcbNets.cs" />
    <Compile Include="$(PcbSrc)\TriangleGrouping.cs" />
    <Compile Include="$(PcbSrc)\StlMesh.cs" />
    <Compile Include="$(PcbSrc)\StepConverter.cs" />
    <Compile Include="$(PcbSrc)\PdfSchematic.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\VoxonTypes.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\LedWinCS.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\LedHostCS.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\NativeInput.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Input.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\SceneCamera.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Sim\VoxelBatch.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Cad\FusionWire.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Cad\FusionClient.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Cad\CadPlacement.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Cad\CadSceneRenderer.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\..\Core\Pcb\CadLight.cs" />
    <Compile Include="TestData.cs" />
    <Compile Include="DesignTreeChecks.cs" />
    <Compile Include="RealBoardCheck.cs" />
    <Compile Include="StepChecks.cs" />
    <Compile Include="ViaSpanChecks.cs" />
    <Compile Include="NetChecks.cs" />
    <Compile Include="StlChecks.cs" />
    <Compile Include="LayoutChecks.cs" />
    <Compile Include="LightChecks.cs" />
    <Compile Include="CircuitChecks.cs" />
    <Compile Include="SchematicChecks.cs" />
    <Compile Include="FusionChecks.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
  </ItemGroup>

</Project>
