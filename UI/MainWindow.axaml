<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EDes.UI.MainWindow"
        Title="EDes"
        Width="1400" Height="760"
        MinWidth="900" MinHeight="480"
        CanResize="True"
        WindowState="Normal"
        RequestedThemeVariant="Dark">

    <!--
        4-row layout:
          Row 0 — Top bar      : app title | motor controls | save/load/reset
          Row 1 — Mode headers : Education | Oscilloscope | PCB  (from IVoxonGame.Modes)
          Row 2 — Content      : mode settings | preview | display settings
          Row 3 — Status bar   : hardware info | live stats | VPS readout

        Row 2 is deliberately three panes rather than a tab strip: the mode's own
        settings sit on the LEFT, the Voxon display settings on the RIGHT, and neither
        can hide the other. The old nav-button list is gone — mode selection moved up
        into Row 1, and the only other panel left is the display one.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ══════════════════════════════════════════════════════════════════
             Row 0 — Top bar
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                Padding="10,6,10,6">
            <Grid ColumnDefinitions="*,Auto,Auto">

                <!-- App name (left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="EDes"
                               FontSize="15" FontWeight="Bold"
                               Foreground="#FF00CCFF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Electronics Design Explorer"
                               FontSize="10" Opacity="0.40"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Motor controls (centre-right, hardware only) -->
                <StackPanel x:Name="MotorPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4" VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            IsVisible="False">
                    <Button x:Name="BtnMotorStart"
                            Padding="10,4" FontSize="11"
                            Background="#1A4A1A" Foreground="#88FF88"
                            BorderBrush="#336633" BorderThickness="1"
                            ToolTip.Tip="Start the spinning platter motor">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Motor On"  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnMotorStop"
                            Padding="10,4" FontSize="11"
                            Background="#4A1A1A" Foreground="#FF8888"
                            BorderBrush="#663333" BorderThickness="1"
                            ToolTip.Tip="Stop the spinning platter motor">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="⬛" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Text="Motor Off" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Save / Load / Reset (right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="SaveBtn"  Content="Save"  Padding="10,4"
                            FontSize="11" Click="OnSaveClick"
                            ToolTip.Tip="Save all settings to disk"/>
                    <Button x:Name="LoadBtn"  Content="Load"  Padding="10,4"
                            FontSize="11" Click="OnLoadClick"
                            ToolTip.Tip="Reload settings from disk"/>
                    <Button x:Name="ResetBtn" Content="Reset" Padding="10,4"
                            FontSize="11" Click="OnResetClick"
                            ToolTip.Tip="Restore all settings to defaults"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             Row 1 — Mode headers (populated from IVoxonGame.Modes in code)
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#080810"
                BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1"
                Padding="10,0,10,0">
            <StackPanel x:Name="ModeHeaderPanel"
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Left"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             Row 2 — Mode settings | preview | display settings
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="320,4,*,4,320">

            <!-- ── Left: the active mode's settings, with the controls pinned below.
                 The control list used to be an accordion section, which meant it was
                 collapsed exactly when someone needed it. It is short and it never
                 changes, so it costs less to leave on screen than to go looking for. -->
            <Grid Grid.Column="0"
                  MinWidth="220" MaxWidth="560"
                  RowDefinitions="Auto,1,*,1,Auto"
                  Background="#0A0A12">
                <TextBlock Grid.Row="0"
                           x:Name="GamePanelTitle"
                           Text="Mode"
                           FontSize="11" FontWeight="Bold"
                           Opacity="0.75"
                           Margin="12,10,12,8"/>
                <Border Grid.Row="1" Background="#22FFFFFF" Margin="8,0"/>
                <ContentControl Grid.Row="2" x:Name="GamePanelArea"/>

                <Border Grid.Row="3" Background="#22FFFFFF" Margin="8,0"/>
                <Border Grid.Row="4" x:Name="ControlsPanel"
                        Background="#0D0D16" Padding="12,8"
                        IsVisible="False">
                    <StackPanel Spacing="3">
                        <TextBlock Text="CONTROLS"
                                   FontSize="10" FontWeight="Bold"
                                   Opacity="0.55"/>
                        <TextBlock x:Name="ControlsText"
                                   Text=""
                                   FontSize="10"
                                   Opacity="0.85"
                                   TextWrapping="Wrap"
                                   FontFamily="Consolas,Menlo,monospace"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          Background="#22FFFFFF"
                          HorizontalAlignment="Stretch"/>

            <!-- ── Centre: 3D preview ─────────────────────────────────────── -->
            <!-- Focusable so clicking it pulls keyboard focus off the settings
                 controls; game keys are then routed to the game, not sliders. -->
            <Border x:Name="PreviewBorder" Grid.Column="2"
                    Background="#000000" Focusable="True">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>

                    <!-- Probe readout, top-left. Mirrors what the volume shows on its
                         own HUD plane, because the operator is often looking at the
                         display rather than the screen — and the same text in both places
                         means neither has to be the authority. Not hit-testable: unlike
                         the legend it has no controls, so it must not eat the orbit drag. -->
                    <Border x:Name="ProbePanel"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="10,10,0,0" Padding="8,6"
                            Background="#C0000000"
                            BorderBrush="#40FFFFFF" BorderThickness="1"
                            CornerRadius="3"
                            MaxWidth="340"
                            IsHitTestVisible="False"
                            IsVisible="False">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="ProbeTitle"
                                       Text="INSPECTION MODE"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="#FF66DDFF"/>
                            <TextBlock x:Name="ProbeBody"
                                       Text=""
                                       FontSize="10"
                                       Opacity="0.9"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas,Menlo,monospace"/>
                        </StackPanel>
                    </Border>

                    <!-- Legend: what is on screen, in what colour, with a checkbox to
                         toggle it and a swatch to recolour it. An Avalonia overlay rather
                         than in-volume text on purpose — it costs no voxel budget, and a
                         clickable colour SWATCH is the whole point, which voxel text
                         cannot render.

                         This one IS hit-testable, unlike the rest of the preview overlay:
                         a drag starting on the panel goes to its controls instead of
                         orbiting the volume. That is the intended trade, and it is why the
                         panel stays small and cornered. -->
                    <Border x:Name="LegendPanel"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,10,10" Padding="8,6"
                            Background="#D0000000"
                            BorderBrush="#30FFFFFF" BorderThickness="1"
                            CornerRadius="3"
                            MaxHeight="320"
                            IsVisible="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LegendItems" Spacing="1"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Background="#22FFFFFF"
                          HorizontalAlignment="Stretch"/>

            <!-- ── Right: Voxon display settings ──────────────────────────── -->
            <Grid Grid.Column="4"
                  MinWidth="220" MaxWidth="560"
                  RowDefinitions="Auto,1,*"
                  Background="#0A0A12">
                <TextBlock Grid.Row="0"
                           Text="Voxon Display"
                           FontSize="11" FontWeight="Bold"
                           Opacity="0.75"
                           Margin="12,10,12,8"/>
                <Border Grid.Row="1" Background="#22FFFFFF" Margin="8,0"/>
                <ContentControl Grid.Row="2" x:Name="DisplayPanelArea"/>
            </Grid>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             Row 3 — Status bar
             ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
                Padding="10,4,10,4">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Left: diagnostics -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock x:Name="DeviceText"
                               Text="Connecting..." FontSize="10" Opacity="0.80"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModelText"
                               Text="" FontSize="10" Opacity="0.60"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VoxelText"
                               Text="" FontSize="10" Opacity="0.60"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LatencyText"
                               Text="" FontSize="10" Opacity="0.60"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="MotorText"
                               Text="" FontSize="10" Opacity="0.60"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="BoundsText"
                               Text="" FontSize="10" Opacity="0.60"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: VPS readout -->
                <TextBlock x:Name="VpsText"
                           Grid.Column="1"
                           Text="VPS: –" FontSize="10" Opacity="0.80"
                           VerticalAlignment="Center"/>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             Splash overlay — covers all rows, shown until the game loop runs.
             ══════════════════════════════════════════════════════════════ -->
        <Border x:Name="SplashOverlay"
                Grid.Row="0" Grid.RowSpan="4"
                Background="#0A0A12"
                IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Image x:Name="SplashImage"
                       MaxWidth="360" MaxHeight="360"
                       HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashTitle"
                           Text="EDes"
                           FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="SplashStatusText"
                           Text="Starting…"
                           FontSize="12" Opacity="0.75"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="380"/>
                <StackPanel x:Name="SplashButtons"
                            Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Center"
                            IsVisible="False">
                    <Button x:Name="SplashRetryBtn"     Content="Retry"/>
                    <Button x:Name="SplashSimulatorBtn"  Content="Continue in Simulator"/>
                    <Button x:Name="SplashQuitBtn"       Content="Quit"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>
